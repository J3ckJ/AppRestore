+package cmd
+
+import (
+	"errors"
+
+	"github.com/majd/ipatool/v2/pkg/appstore"
+	"github.com/spf13/cobra"
+)
+
+type downloadProber interface {
+	ProbeDownload(appstore.DownloadProbeInput) (appstore.DownloadProbeOutput, error)
+}
+
+func probeDownloadCmd() *cobra.Command {
+	return probeDownloadCmdWithAppStore(func() appstore.AppStore { return dependencies.AppStore })
+}
+
+func probeDownloadCmdWithAppStore(factory func() appstore.AppStore) *cobra.Command {
+	var appID int64
+	var versionID string
+	cmd := &cobra.Command{
+		Use:   "probe-download",
+		Short: "Inspect download channels without purchase, asset download or private response data",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if appID <= 0 {
+				return errors.New("a positive app ID is required")
+			}
+			store := factory()
+			prober, ok := store.(downloadProber)
+			if !ok {
+				return errors.New("download probe is not supported by this build")
+			}
+			info, err := store.AccountInfo()
+			if err != nil {
+				return errors.New("cannot open saved account for download probe")
+			}
+			out, err := prober.ProbeDownload(appstore.DownloadProbeInput{Context: cmd.Context(), Account: info.Account, App: appstore.App{ID: appID}, ExternalVersionID: versionID})
+			if err != nil {
+				return err
+			}
+			dependencies.Logger.Log().Interface("probe", out).Bool("success", true).Send()
+			return nil
+		},
+	}
+	cmd.Flags().Int64VarP(&appID, "app-id", "i", 0, "App Store ID to inspect")
+	cmd.Flags().StringVar(&versionID, "external-version-id", "", "Known version ID to inspect without a public catalog card")
+	return cmd
+}

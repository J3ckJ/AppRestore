+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/appstore"
+	"github.com/majd/ipatool/v2/pkg/log"
+)
+
+type fakeDownloadProber struct {
+	*fakePurchaseAppStore
+	input appstore.DownloadProbeInput
+}
+
+func (f *fakeDownloadProber) ProbeDownload(input appstore.DownloadProbeInput) (appstore.DownloadProbeOutput, error) {
+	f.input = input
+	return appstore.DownloadProbeOutput{AppID: input.App.ID}, nil
+}
+
+func TestProbeCommandDoesNotDownloadOrPurchase(t *testing.T) {
+	previous := dependencies
+	defer func() { dependencies = previous }()
+	dependencies.Logger = log.NewLogger(log.Args{})
+	store := &fakeDownloadProber{fakePurchaseAppStore: &fakePurchaseAppStore{}}
+	cmd := probeDownloadCmdWithAppStore(func() appstore.AppStore { return store })
+	cmd.SetContext(context.Background())
+	cmd.SetArgs([]string{"--app-id", "1117817509", "--external-version-id", "123"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	if store.input.App.ID != 1117817509 || store.input.ExternalVersionID != "123" || store.purchaseInput.App.ID != 0 || store.lookupCalls != 0 {
+		t.Fatal("wrong probe/purchase input")
+	}
+	if cmd.Flag("purchase") != nil {
+		t.Fatal("probe exposes purchase")
+	}
+}
+
+func TestProbeCommandRequiresIDBeforeAccount(t *testing.T) {
+	cmd := probeDownloadCmdWithAppStore(func() appstore.AppStore { t.Fatal("must not access account"); return nil })
+	cmd.SetArgs([]string{})
+	if err := cmd.Execute(); err == nil {
+		t.Fatal("accepted missing ID")
+	}
+}

+package appstore
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+	"github.com/majd/ipatool/v2/pkg/util/machine"
+	"go.uber.org/mock/gomock"
+)
+
+func TestProbeResponsePrivacyAndIdentity(t *testing.T) {
+	app := App{ID: 42, BundleID: "com.example.app"}
+	res := http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{Items: []downloadItemResult{{URL: "https://private.example/asset?token=secret", Sinfs: []Sinf{{Data: []byte("secret license")}}, Metadata: map[string]interface{}{
+		"itemId": int64(42), "softwareVersionBundleId": app.BundleID, "softwareVersionExternalIdentifier": "123", "appleId": "private@example.com",
+	}}}}}
+	got := probeResponse("volume_pinned", app, "123", res, nil)
+	if got.Status != "package_and_license_offered" || !got.IdentityMatches || !got.PackageOffered || !got.LicenseMaterial {
+		t.Fatalf("unexpected result: %+v", got)
+	}
+	data, _ := json.Marshal(got)
+	for _, private := range []string{"secret", "private", "example.com", "Sinfs", "URL"} {
+		if strings.Contains(string(data), private) {
+			t.Fatal("private data leaked")
+		}
+	}
+	if got := probeResponse("volume_pinned", app, "124", res, nil); got.Status != "identity_mismatch" || got.PackageOffered {
+		t.Fatal("accepted another version")
+	}
+	res.Data.Items[0].Sinfs = []Sinf{{}}
+	if got := probeResponse("volume_pinned", app, "123", res, nil); got.LicenseMaterial || got.Status != "metadata_only" {
+		t.Fatal("empty SINF is not license material")
+	}
+	res.Data.Items[0].Metadata["itemId"] = 43
+	if got := probeResponse("redownload_unpinned", app, "", res, nil); got.Status != "identity_mismatch" || got.LicenseMaterial {
+		t.Fatal("accepted another app")
+	}
+}
+
+func TestProbeResponseRefusalsAndErrors(t *testing.T) {
+	for code, expected := range map[string]string{"9610": "license_required", "2059": "unavailable", "2042": "authentication_required", "-128": "store_mismatch", "2040": "apple_refused", "email=private@example.com": "apple_refused"} {
+		res := http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{FailureType: code, CustomerMessage: "token=secret"}}
+		got := probeResponse("volume_unpinned", App{ID: 42}, "", res, nil)
+		if got.Status != expected || got.PackageOffered || got.LicenseMaterial {
+			t.Fatalf("wrong refusal for %s", code)
+		}
+		data, _ := json.Marshal(got)
+		if strings.Contains(string(data), "secret") || strings.Contains(string(data), "example.com") {
+			t.Fatal("private refusal leaked")
+		}
+	}
+	got := probeResponse("volume_unpinned", App{ID: 42}, "", http.Result[downloadResult]{}, &http.UnexpectedResponseError{StatusCode: 403, Snippet: "private token"})
+	if got.HTTPStatus != 403 || got.Status != "network_or_protocol_error" {
+		t.Fatal("lost HTTP status")
+	}
+	if got := probeResponse("volume_unpinned", App{ID: 42}, "", http.Result[downloadResult]{}, context.DeadlineExceeded); got.Status != "cancelled_or_timeout" {
+		t.Fatal("lost cancellation")
+	}
+}
+
+func TestProbeReadOnlyChannelsAfterLicenseRefusal(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	download := http.NewMockClient[downloadResult](ctrl)
+	bag := http.NewMockClient[bagResult](ctrl)
+	mach := machine.NewMockMachine(ctrl)
+	store := &appstore{downloadClient: download, bagClient: bag, machine: mach}
+	app := App{ID: 42, BundleID: "com.example.app"}
+	acc := Account{Pod: "42", StoreFront: "143469-16,29", DirectoryServicesID: "private", PasswordToken: "secret"}
+	mach.EXPECT().MacAddress().Return("00:11:22:33:44:55", nil)
+	bag.EXPECT().Send(gomock.Any()).Return(http.Result[bagResult]{StatusCode: 200, Data: bagResult{URLBag: urlBag{RedownloadEndpoint: testRedownloadEndpoint, UpdateEndpoint: testUpdateEndpoint}}}, nil)
+	calls := 0
+	download.EXPECT().Send(gomock.Any()).DoAndReturn(func(req http.Request) (http.Result[downloadResult], error) {
+		calls++
+		if req.Context == nil || !req.NoRedirects {
+			t.Fatal("unbounded/redirecting probe")
+		}
+		payload := req.Payload.(*http.XMLPayload).Content
+		if payload["salableAdamId"] != app.ID || req.Headers["iCloud-DSID"] != acc.DirectoryServicesID {
+			t.Fatal("changed account or app")
+		}
+		for _, field := range []string{"price", "pricingParameters", "buyWithoutAuthorization"} {
+			if _, ok := payload[field]; ok {
+				t.Fatal("purchase payload in probe")
+			}
+		}
+		if strings.Contains(req.URL, "buyProduct") {
+			t.Fatal("purchase endpoint in probe")
+		}
+		if calls == 2 {
+			if !strings.HasPrefix(req.URL, "https://p25-buy.itunes.apple.com/") {
+				t.Fatal("not legacy route")
+			}
+			if _, ok := payload["serialNumber"]; ok {
+				t.Fatal("not legacy payload")
+			}
+		}
+		if calls == 3 {
+			return http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{Items: []downloadItemResult{{URL: "private", Sinfs: []Sinf{{Data: []byte("private license")}}, Metadata: map[string]interface{}{"itemId": app.ID, "softwareVersionBundleId": app.BundleID, "softwareVersionExternalIdentifier": "123"}}}}}, nil
+		}
+		if calls == 4 {
+			if _, ok := payload["serialNumber"]; ok {
+				t.Fatal("not minimal dispatch payload")
+			}
+		}
+		return http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{FailureType: FailureTypeLicenseNotFound}}, nil
+	}).Times(7)
+	out, err := store.ProbeDownload(DownloadProbeInput{Account: acc, App: app, ExternalVersionID: "123"})
+	if err != nil || out.Country != "RU" || len(out.Channels) != 8 {
+		t.Fatalf("unexpected probe: %+v %v", out, err)
+	}
+	if out.Channels[2].Status != "package_and_license_offered" {
+		t.Fatal("stopped at initial license refusal")
+	}
+}
+
+func TestProbeRejectsInvalidInputBeforeRequests(t *testing.T) {
+	for _, input := range []DownloadProbeInput{{}, {App: App{ID: 42}, ExternalVersionID: "email=private"}} {
+		if _, err := (&appstore{}).ProbeDownload(input); err == nil {
+			t.Fatal("accepted invalid input")
+		}
+	}
+	ctrl := gomock.NewController(t)
+	mach := machine.NewMockMachine(ctrl)
+	mach.EXPECT().MacAddress().Return("", errors.New("private mac address"))
+	_, err := (&appstore{machine: mach}).ProbeDownload(DownloadProbeInput{App: App{ID: 42}})
+	if err == nil || strings.Contains(err.Error(), "private") {
+		t.Fatal("leaked machine error")
+	}
+}
+
+func TestProbeFollowsOnlySameOperationAppleRedirect(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	download := http.NewMockClient[downloadResult](ctrl)
+	store := &appstore{downloadClient: download}
+	req := store.downloadProductRequest(store.volumeStoreEndpoint(Account{}), Account{}, App{ID: 42}, "001122334455", "")
+	req.Context, req.NoRedirects = context.Background(), true
+	download.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{StatusCode: 302, Headers: map[string]string{"Location": "https://p42-buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload}}, nil)
+	download.EXPECT().Send(gomock.Any()).DoAndReturn(func(next http.Request) (http.Result[downloadResult], error) {
+		if !next.NoRedirects || next.Method != http.MethodPOST || next.URL != "https://p42-buy.itunes.apple.com"+PrivateAppStoreAPIPathDownload+"?guid=001122334455" {
+			t.Fatal("lost POST, GUID or redirect restriction")
+		}
+		return http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{FailureType: FailureTypeLicenseNotFound}}, nil
+	})
+	res, err := store.sendProbeProduct(req)
+	if err != nil || res.Data.FailureType != FailureTypeLicenseNotFound {
+		t.Fatal("did not follow approved Store pod redirect")
+	}
+}
+
+func TestProbeRejectsPrivatePurchaseAndRegionRedirects(t *testing.T) {
+	for _, location := range []string{
+		"https://private.example/asset?token=secret",
+		"http://p42-buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload,
+		"https://buy.itunes.apple.com" + PrivateAppStoreAPIPathPurchase,
+		"https://buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload + "?country=US",
+		"https://secret@buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload,
+		"https://buy.itunes.apple.com:443" + PrivateAppStoreAPIPathDownload,
+	} {
+		ctrl := gomock.NewController(t)
+		download := http.NewMockClient[downloadResult](ctrl)
+		store := &appstore{downloadClient: download}
+		req := store.downloadProductRequest(store.volumeStoreEndpoint(Account{}), Account{}, App{ID: 42}, "001122334455", "")
+		download.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{StatusCode: 302, Headers: map[string]string{"Location": location}}, nil)
+		res, err := store.sendProbeProduct(req)
+		if !errors.Is(err, errProbeRedirect) || probeResponse("legacy_volume_unpinned", App{ID: 42}, "", res, err).Status != "invalid_redirect" {
+			t.Fatal("accepted unsafe redirect")
+		}
+	}
+}
+
+func TestProbeRedirectsAreBounded(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	download := http.NewMockClient[downloadResult](ctrl)
+	store := &appstore{downloadClient: download}
+	req := store.downloadProductRequest(store.volumeStoreEndpoint(Account{}), Account{}, App{ID: 42}, "001122334455", "")
+	download.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{StatusCode: 302, Headers: map[string]string{"Location": "https://p42-buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload}}, nil).Times(4)
+	_, err := store.sendProbeProduct(req)
+	if !errors.Is(err, errProbeRedirectLimit) {
+		t.Fatal("unbounded diagnostic redirect")
+	}
+}

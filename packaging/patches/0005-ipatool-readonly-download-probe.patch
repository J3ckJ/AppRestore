@@ -0,0 +1,323 @@
+package appstore
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	gohttp "net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+)
+
+// ProbeDownload only requests product metadata. It never purchases, downloads
+// an asset, installs, logs in again, or returns URLs, cookies, SINF or identity.
+type DownloadProbeInput struct {
+	Context           context.Context
+	Account           Account
+	App               App
+	ExternalVersionID string
+}
+
+type DownloadProbeChannel struct {
+	Channel         string `json:"channel"`
+	Status          string `json:"status"`
+	HTTPStatus      int    `json:"httpStatus,omitempty"`
+	FailureType     string `json:"failureType,omitempty"`
+	VersionID       string `json:"versionId,omitempty"`
+	PackageOffered  bool   `json:"packageOffered"`
+	LicenseMaterial bool   `json:"licenseMaterial"`
+	IdentityMatches bool   `json:"identityMatches"`
+}
+
+type DownloadProbeOutput struct {
+	AppID    int64                  `json:"appId"`
+	Country  string                 `json:"country"`
+	Channels []DownloadProbeChannel `json:"channels"`
+}
+
+var probeStoreHost = regexp.MustCompile(`^(p[0-9]{1,5}-)?buy\.itunes\.apple\.com$`)
+
+var errProbeRedirect = errors.New("invalid diagnostic redirect")
+var errProbeRedirectLimit = errors.New("diagnostic redirect limit")
+
+// Follow only a bounded redirect to the exact same product operation on an
+// approved Apple Store host. Never allow a redirect to purchase or asset URLs.
+func (t *appstore) sendProbeProduct(req http.Request) (http.Result[downloadResult], error) {
+	for attempt := 0; attempt <= 3; attempt++ {
+		res, err := t.downloadClient.Send(req)
+		if err != nil || !http.IsAuthenticationRedirect(res.StatusCode) {
+			return res, err
+		}
+		if attempt == 3 {
+			return res, errProbeRedirectLimit
+		}
+		location, locErr := res.GetHeader("Location")
+		base, baseErr := url.Parse(req.URL)
+		next, nextErr := url.Parse(location)
+		if locErr != nil || baseErr != nil || nextErr != nil {
+			return res, errProbeRedirect
+		}
+		next = base.ResolveReference(next)
+		host := strings.ToLower(next.Host)
+		allowedHost := probeStoreHost.MatchString(host) || host == downloadDispatchDomain
+		if next.Scheme != "https" || !allowedHost || next.User != nil || next.Fragment != "" ||
+			next.Path != base.Path || next.RawPath != "" {
+			return res, errProbeRedirect
+		}
+		// Preserve the device GUID, not any new account/region/purchase params.
+		query := next.Query()
+		if len(query) > 1 || (len(query) == 1 && query.Get("guid") != base.Query().Get("guid")) {
+			return res, errProbeRedirect
+		}
+		if len(query) == 0 {
+			next.RawQuery = base.RawQuery
+		}
+		req.URL = next.String()
+	}
+	return http.Result[downloadResult]{}, errProbeRedirectLimit
+}
+
+func positiveProbeID(value string) bool {
+	if value == "" || len(value) > 18 {
+		return false
+	}
+	for _, char := range value {
+		if char < '0' || char > '9' {
+			return false
+		}
+	}
+	id, err := strconv.ParseInt(value, 10, 64)
+	return err == nil && id > 0
+}
+
+func safeProbeFailure(value string) string {
+	if len(value) > 12 {
+		return "unknown"
+	}
+	if _, err := strconv.ParseInt(value, 10, 32); err != nil {
+		return "unknown"
+	}
+	return value
+}
+
+func probeResponse(channel string, app App, version string, res http.Result[downloadResult], err error) DownloadProbeChannel {
+	out := DownloadProbeChannel{Channel: channel, Status: "network_or_protocol_error", HTTPStatus: res.StatusCode}
+	if err != nil {
+		if errors.Is(err, errProbeRedirect) {
+			out.Status = "invalid_redirect"
+		} else if errors.Is(err, errProbeRedirectLimit) {
+			out.Status = "redirect_limit"
+		}
+		var unexpected *http.UnexpectedResponseError
+		if errors.As(err, &unexpected) {
+			out.HTTPStatus = unexpected.StatusCode
+		}
+		if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+			out.Status = "cancelled_or_timeout"
+		}
+		return out // never print err: it may contain authenticated URLs or response data
+	}
+	if res.Data.FailureType != "" {
+		out.FailureType = safeProbeFailure(res.Data.FailureType)
+		switch res.Data.FailureType {
+		case FailureTypeLicenseNotFound:
+			out.Status = "license_required"
+		case FailureTypeTemporarilyUnavailable:
+			out.Status = "unavailable"
+		case FailureTypePasswordTokenExpired, FailureTypeSignInRequired, FailureTypeDeviceVerificationFailed:
+			out.Status = "authentication_required"
+		case "-128":
+			out.Status = "store_mismatch"
+		default:
+			out.Status = "apple_refused"
+		}
+		return out
+	}
+	if res.StatusCode != gohttp.StatusOK {
+		out.Status = "http_error"
+		return out
+	}
+	if res.Data.CustomerMessage != "" {
+		out.Status = "apple_refused"
+		return out
+	}
+	if len(res.Data.Items) == 0 {
+		out.Status = "empty"
+		return out
+	}
+	if len(res.Data.Items) != 1 {
+		out.Status = "invalid_response"
+		return out
+	}
+	item := res.Data.Items[0]
+	bundle, ok := item.Metadata["softwareVersionBundleId"].(string)
+	actualVersion := fmt.Sprint(item.Metadata["softwareVersionExternalIdentifier"])
+	if positiveProbeID(actualVersion) {
+		out.VersionID = actualVersion
+	}
+	out.IdentityMatches = fmt.Sprint(item.Metadata["itemId"]) == fmt.Sprint(app.ID) && ok && bundle != "" &&
+		(app.BundleID == "" || bundle == app.BundleID) && (version == "" || version == actualVersion)
+	if !out.IdentityMatches {
+		out.Status = "identity_mismatch"
+		return out
+	}
+	out.PackageOffered = item.URL != ""
+	for _, sinf := range item.Sinfs {
+		if len(sinf.Data) > 0 {
+			out.LicenseMaterial = true
+			break
+		}
+	}
+	out.Status = "metadata_only"
+	if out.PackageOffered && out.LicenseMaterial {
+		out.Status = "package_and_license_offered"
+	}
+	return out
+}
+
+func (t *appstore) probeVersion(ctx context.Context, acc Account, app App) (string, DownloadProbeChannel) {
+	result := DownloadProbeChannel{Channel: "version_lookup", Status: "version_unavailable"}
+	country, err := countryCodeFromStoreFront(acc.StoreFront)
+	if err != nil {
+		result.Status = "country_unavailable"
+		return "", result
+	}
+	metadataPlatform, _ := PlatformIPhone.metadataPlatform()
+	for _, catalog := range []string{metadataPlatform, "iphone", "ipad"} {
+		req := t.platformVersionLookupRequest(app.ID, country, catalog)
+		req.Context, req.NoRedirects = ctx, true
+		res, sendErr := t.platformClient.Send(req)
+		result.HTTPStatus = res.StatusCode
+		if sendErr != nil {
+			result.Status = "network_or_protocol_error"
+			return "", result
+		}
+		if res.StatusCode != gohttp.StatusOK {
+			result.Status = "http_error"
+			return "", result
+		}
+		item, ok := res.Data.Results[strconv.FormatInt(app.ID, 10)]
+		if !ok || len(item.Offers) == 0 {
+			continue
+		}
+		version := string(item.Offers[0].Version.ExternalID)
+		if version == "" {
+			version, err = externalVersionIDFromBuyParams(item.Offers[0].BuyParams)
+		}
+		if err != nil || !positiveProbeID(version) {
+			result.Status = "invalid_response"
+			return "", result
+		}
+		result.Status, result.VersionID = "version_found", version
+		return version, result
+	}
+	return "", result
+}
+
+func (t *appstore) ProbeDownload(input DownloadProbeInput) (DownloadProbeOutput, error) {
+	if input.App.ID <= 0 || (input.ExternalVersionID != "" && !positiveProbeID(input.ExternalVersionID)) {
+		return DownloadProbeOutput{}, errors.New("probe requires a positive app ID and an optional positive external version ID")
+	}
+	ctx := input.Context
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(ctx, 75*time.Second)
+	defer cancel()
+	macAddr, err := t.machine.MacAddress()
+	if err != nil {
+		return DownloadProbeOutput{}, errors.New("failed to resolve diagnostic device identity")
+	}
+	guid := strings.ReplaceAll(strings.ToUpper(macAddr), ":", "")
+	country, _ := countryCodeFromStoreFront(input.Account.StoreFront)
+	out := DownloadProbeOutput{AppID: input.App.ID, Country: country, Channels: []DownloadProbeChannel{}}
+	acc, app := input.Account, input.App
+	request := func(channel string, endpoint downloadProductEndpoint, version string, legacy bool) {
+		if ctx.Err() != nil {
+			out.Channels = append(out.Channels, DownloadProbeChannel{Channel: channel, Status: "cancelled_or_timeout"})
+			return
+		}
+		req := t.downloadProductRequest(endpoint, acc, app, guid, version)
+		if legacy {
+			delete(req.Payload.(*http.XMLPayload).Content, "serialNumber")
+		}
+		req.Context, req.NoRedirects = ctx, true
+		res, sendErr := t.sendProbeProduct(req)
+		out.Channels = append(out.Channels, probeResponse(channel, app, version, res, sendErr))
+	}
+	// Compare the ordinary pod route with the pre-2.3 CLI's p25 route and
+	// payload. Account, DSID, cookies, device GUID and storefront stay unchanged.
+	request("volume_unpinned", t.volumeStoreEndpoint(acc), "", false)
+	legacy := downloadProductEndpoint{baseURL: "https://p25-buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload, versionKey: downloadVersionKeyVolumeStore}
+	request("legacy_volume_unpinned", legacy, "", true)
+	bagReq := t.bagRequest(guid)
+	bagReq.Context, bagReq.NoRedirects = ctx, true
+	bagRes, bagErr := t.bagClient.Send(bagReq)
+	bag := bagRes.Data.URLBag
+	bagOK := bagErr == nil && bagRes.StatusCode == gohttp.StatusOK
+	endpoint := func(channel, raw, path, version string) {
+		if !bagOK || raw == "" {
+			out.Channels = append(out.Channels, DownloadProbeChannel{Channel: channel, Status: "endpoint_unavailable"})
+			return
+		}
+		ep, epErr := newDownloadEndpoint(raw, path)
+		if epErr != nil {
+			out.Channels = append(out.Channels, DownloadProbeChannel{Channel: channel, Status: "invalid_endpoint"})
+			return
+		}
+		request(channel, ep, version, false)
+	}
+	// Deliberately inspect each read-only channel even after a license refusal.
+	// A probe is not a fallback purchase and cannot grant access itself.
+	endpoint("redownload_unpinned", bag.RedownloadEndpoint, redownloadProductPath, "")
+	// ApplePackage/Asspp uses the same dispatch operation with the older,
+	// minimal payload (no serialNumber). Inspect it without changing account.
+	minimal, minimalErr := newDownloadEndpoint("https://"+downloadDispatchDomain+redownloadProductPath, redownloadProductPath)
+	if minimalErr != nil {
+		out.Channels = append(out.Channels, DownloadProbeChannel{Channel: "minimal_redownload_unpinned", Status: "invalid_endpoint"})
+	} else {
+		request("minimal_redownload_unpinned", minimal, "", true)
+	}
+	version := input.ExternalVersionID
+	if version == "" {
+		for _, result := range out.Channels {
+			if result.IdentityMatches && result.VersionID != "" {
+				version = result.VersionID
+				break
+			}
+		}
+	}
+	if version == "" && ctx.Err() == nil {
+		var lookup DownloadProbeChannel
+		version, lookup = t.probeVersion(ctx, acc, app)
+		out.Channels = append(out.Channels, lookup)
+	}
+	if version == "" {
+		for _, channel := range []string{"volume_pinned", "redownload_pinned", "update_pinned", "ent_pinned"} {
+			out.Channels = append(out.Channels, DownloadProbeChannel{Channel: channel, Status: "version_unavailable"})
+		}
+		return out, nil
+	}
+	request("volume_pinned", t.volumeStoreEndpoint(acc), version, false)
+	endpoint("redownload_pinned", bag.RedownloadEndpoint, redownloadProductPath, version)
+	endpoint("update_pinned", bag.UpdateEndpoint, updateProductPath, version)
+	if !bagOK || bag.EntDownloadEndpoint == "" || t.kbsyncGenerator == nil {
+		out.Channels = append(out.Channels, DownloadProbeChannel{Channel: "ent_pinned", Status: "endpoint_unavailable"})
+	} else if ep, epErr := newDownloadEndpoint(bag.EntDownloadEndpoint, entDownloadPath); epErr != nil {
+		out.Channels = append(out.Channels, DownloadProbeChannel{Channel: "ent_pinned", Status: "invalid_endpoint"})
+	} else {
+		res, sendErr := t.sendEntDownload(ctx, ep, acc, app, guid, version)
+		// sendEntDownload returns a safe-to-classify response along with Apple
+		// refusals; preserve its numeric code, but never its error/metadata dump.
+		if res.StatusCode != 0 && res.Data.FailureType != "" {
+			sendErr = nil
+		}
+		out.Channels = append(out.Channels, probeResponse("ent_pinned", app, version, res, sendErr))
+	}
+	return out, nil
+}
diff --git a/pkg/appstore/appstore_probe_download_test.go b/pkg/appstore/appstore_probe_download_test.go

index 0000000000000000000000000000000000000000..06a153dbad670d9ce7f0682df89521085878886b
--- /dev/null
+++ b/pkg/appstore/storefront_test.go
@@ -0,0 +1,27 @@
+package appstore
+
+import (
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("Storefront helpers", func() {
+	DescribeTable("extracts the numeric storefront and its country", func(raw, id, country string) {
+		Expect(StoreFrontID(raw)).To(Equal(id))
+
+		code, err := CountryCodeFromStoreFront(raw)
+		if country == "" {
+			Expect(err).To(HaveOccurred())
+		} else {
+			Expect(err).NotTo(HaveOccurred())
+			Expect(code).To(Equal(country))
+		}
+	},
+		Entry("login header with language and platform", "143469-16,29", "143469", "RU"),
+		Entry("header with platform only", "143441,32", "143441", "US"),
+		Entry("bare identifier", "143443", "143443", "DE"),
+		Entry("surrounding whitespace", " 143469-16,29 ", "143469", "RU"),
+		Entry("unknown identifier", "999999-1,29", "999999", ""),
+		Entry("empty value", "", "", ""),
+	)
+})

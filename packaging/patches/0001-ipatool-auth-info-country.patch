diff --git a/cmd/auth_info_test.go b/cmd/auth_info_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5dc3570146065a8e56def4b351e4fa06b9475029
--- /dev/null
+++ b/cmd/auth_info_test.go
@@ -0,0 +1,61 @@
+package cmd
+
+import (
+	"bytes"
+	"encoding/json"
+
+	"github.com/majd/ipatool/v2/pkg/appstore"
+	"github.com/majd/ipatool/v2/pkg/log"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type fakeInfoAppStore struct {
+	appstore.AppStore
+	account appstore.Account
+}
+
+func (f *fakeInfoAppStore) AccountInfo() (appstore.AccountInfoOutput, error) {
+	return appstore.AccountInfoOutput{Account: f.account}, nil
+}
+
+var _ = Describe("Auth info command", func() {
+	run := func(account appstore.Account) map[string]any {
+		previousDependencies := dependencies
+		DeferCleanup(func() { dependencies = previousDependencies })
+
+		var out bytes.Buffer
+		dependencies.AppStore = &fakeInfoAppStore{account: account}
+		dependencies.Logger = log.NewLogger(log.Args{Writer: &out})
+
+		Expect(infoCmd().Execute()).To(Succeed())
+
+		var payload map[string]any
+		Expect(json.Unmarshal(bytes.TrimSpace(out.Bytes()), &payload)).To(Succeed())
+
+		return payload
+	}
+
+	It("reports the account's own storefront and country", func() {
+		payload := run(appstore.Account{Name: "A", Email: "a@example.test", StoreFront: "143469-16,29"})
+
+		Expect(payload).To(HaveKeyWithValue("storeFront", "143469-16,29"))
+		Expect(payload).To(HaveKeyWithValue("countryCode", "RU"))
+		Expect(payload).To(HaveKeyWithValue("success", true))
+	})
+
+	It("omits the country when the storefront is unknown", func() {
+		payload := run(appstore.Account{StoreFront: "999999-1,29"})
+
+		Expect(payload).To(HaveKeyWithValue("storeFront", "999999-1,29"))
+		Expect(payload).NotTo(HaveKey("countryCode"))
+		Expect(payload).To(HaveKeyWithValue("success", true))
+	})
+
+	It("omits both fields for an account saved without a storefront", func() {
+		payload := run(appstore.Account{Name: "A"})
+
+		Expect(payload).NotTo(HaveKey("storeFront"))
+		Expect(payload).NotTo(HaveKey("countryCode"))
+	})
+})
diff --git a/pkg/appstore/storefront.go b/pkg/appstore/storefront.go
index 8509321164083f6441407a81dd84e2e92cbf1dc2..fd2a7006b88c6518ecbaf35ce2dc5ee7199659df 100644
--- a/pkg/appstore/storefront.go
+++ b/pkg/appstore/storefront.go
@@ -297,3 +297,28 @@ func storefrontIdentifier(storeFront string) string {
 func storefrontMappingError(storeFront string) error {
 	return fmt.Errorf("country code mapping for store front (%s) was not found", storeFront)
 }
+
+// StoreFrontID returns the numeric storefront identifier (for example "143469")
+// from a stored X-Set-Apple-Store-Front value such as "143469-16,29".
+func StoreFrontID(storeFront string) string {
+	id, _, _ := strings.Cut(strings.TrimSpace(storeFront), ",")
+	id, _, _ = strings.Cut(id, "-")
+
+	return id
+}
+
+// CountryCodeFromStoreFront maps a stored storefront value to its ISO 3166-1
+// alpha-2 country code (for example "RU"). It only reads the value.
+func CountryCodeFromStoreFront(storeFront string) (string, error) {
+	return countryCodeFromStoreFront(StoreFrontID(storeFront), staticStoreFronts)
+}
+
+// countryCodeForDiagnostics prefers the dynamically discovered storefronts and
+// falls back to the offline map so diagnostics never fail on discovery alone.
+func (t *appstore) countryCodeForDiagnostics(storeFront string) (string, error) {
+	if code, err := CountryCodeFromStoreFront(storeFront); err == nil {
+		return code, nil
+	}
+
+	return t.countryCodeFromStoreFront(storeFront)
+}

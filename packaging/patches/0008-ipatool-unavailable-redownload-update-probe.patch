diff --git a/pkg/appstore/appstore_unavailable_2059_test.go b/pkg/appstore/appstore_unavailable_2059_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..03cb1c418a1f7e55fc12dc1905baf2d6247a83eb
--- /dev/null
+++ b/pkg/appstore/appstore_unavailable_2059_test.go
@@ -0,0 +1,28 @@
+package appstore
+
+import (
+	gohttp "net/http"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+)
+
+// AppRestore: an empty volumeStore 2059 may still be served by redownload.
+func TestTemporarilyUnavailableWithoutItemsIsAvailabilityResponse(t *testing.T) {
+	ok := http.Result[downloadResult]{StatusCode: gohttp.StatusOK, Data: downloadResult{FailureType: FailureTypeTemporarilyUnavailable}}
+	if !isUnavailableDownloadProductResponse(ok) {
+		t.Fatal("2059 without items must allow the read-only redownload channel")
+	}
+
+	for _, res := range []http.Result[downloadResult]{
+		{StatusCode: 403, Data: downloadResult{FailureType: FailureTypeTemporarilyUnavailable}},
+		{StatusCode: gohttp.StatusOK, Data: downloadResult{FailureType: FailureTypeTemporarilyUnavailable, Items: make([]downloadItemResult, 1)}},
+		{StatusCode: gohttp.StatusOK, Data: downloadResult{FailureType: FailureTypeLicenseNotFound}},
+		{StatusCode: gohttp.StatusOK, Data: downloadResult{FailureType: FailureTypePasswordTokenExpired}},
+		{StatusCode: gohttp.StatusOK, Data: downloadResult{FailureType: "-128"}},
+	} {
+		if isUnavailableDownloadProductResponse(res) {
+			t.Fatalf("must not reinterpret %+v as availability", res)
+		}
+	}
+}

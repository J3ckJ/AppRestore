diff --git a/cmd/keychain_passphrase.go b/cmd/keychain_passphrase.go
new file mode 100644
index 0000000..9e62bd2
--- /dev/null
+++ b/cmd/keychain_passphrase.go
@@ -0,0 +1,129 @@
+package cmd
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"sync"
+)
+
+// KeychainPassphraseEnv lets callers pass the file-keyring passphrase without
+// putting it on the command line, where other local users can read it (ps).
+const KeychainPassphraseEnv = "IPATOOL_KEYCHAIN_PASSPHRASE"
+
+var errKeychainPassphraseRequired = errors.New("keychain passphrase is required when not running in interactive mode; " +
+	"use the \"--keychain-passphrase\" flag, the " + KeychainPassphraseEnv + " environment variable or \"--keychain-passphrase-stdin\"")
+
+var keychainPassphraseStdin bool
+
+// keychainPassphraseSource resolves the passphrase in priority order:
+// explicit --keychain-passphrase flag, then the environment variable, then the
+// first line of stdin when --keychain-passphrase-stdin is set. Stdin is read
+// at most once and only when the keyring actually needs the passphrase.
+type keychainPassphraseSource struct {
+	flag     string
+	getenv   func(string) string
+	stdin    io.Reader
+	useStdin bool
+
+	once     sync.Once
+	fromPipe string
+	pipeErr  error
+}
+
+// resolve returns the passphrase, or "" when no non-interactive source is set
+// (the caller then keeps the old behaviour: prompt or fail).
+func (s *keychainPassphraseSource) resolve() (string, error) {
+	if s.flag != "" {
+		return s.flag, nil
+	}
+
+	if s.getenv != nil {
+		if value := s.getenv(KeychainPassphraseEnv); value != "" {
+			return value, nil
+		}
+	}
+
+	if !s.useStdin {
+		return "", nil
+	}
+
+	s.once.Do(func() {
+		s.fromPipe, s.pipeErr = readPassphraseLine(s.stdin)
+	})
+
+	if s.pipeErr != nil {
+		return "", s.pipeErr
+	}
+
+	if s.fromPipe == "" {
+		return "", errors.New("--keychain-passphrase-stdin was set but stdin did not contain a passphrase")
+	}
+
+	return s.fromPipe, nil
+}
+
+// readPassphraseLine reads one line byte by byte so nothing after the newline
+// is consumed (later prompts may still read stdin).
+func readPassphraseLine(reader io.Reader) (string, error) {
+	if reader == nil {
+		return "", errors.New("stdin is not available")
+	}
+
+	var builder strings.Builder
+
+	buffer := make([]byte, 1)
+
+	for {
+		n, err := reader.Read(buffer)
+		if n == 1 {
+			if buffer[0] == '\n' {
+				break
+			}
+
+			builder.WriteByte(buffer[0])
+		}
+
+		if errors.Is(err, io.EOF) {
+			break
+		}
+
+		if err != nil {
+			return "", fmt.Errorf("failed to read keychain passphrase from stdin: %w", err)
+		}
+	}
+
+	return strings.TrimSuffix(builder.String(), "\r"), nil
+}
+
+// keychainFilePasswordFunc is the file-keyring password callback: a
+// non-interactive source first, then the old prompt or error.
+func keychainFilePasswordFunc(source *keychainPassphraseSource, interactive bool) func(string) (string, error) {
+	return func(message string) (string, error) {
+		passphrase, err := source.resolve()
+		if err != nil {
+			return "", err
+		}
+
+		if passphrase != "" {
+			return passphrase, nil
+		}
+
+		if !interactive {
+			return "", errKeychainPassphraseRequired
+		}
+
+		path := message
+		if _, after, found := strings.Cut(message, " unlock "); found {
+			path = after
+		}
+
+		password, err := readPrompt(fmt.Sprintf("enter passphrase to unlock %s (this is separate from your Apple ID password): ", path), true)
+		if err != nil {
+			return "", fmt.Errorf("failed to read password: %w", err)
+		}
+
+		return password, nil
+	}
+}
diff --git a/cmd/keychain_passphrase_test.go b/cmd/keychain_passphrase_test.go
new file mode 100644
index 0000000..b2efc3f
--- /dev/null
+++ b/cmd/keychain_passphrase_test.go
@@ -0,0 +1,140 @@
+package cmd
+
+import (
+	"io"
+	"strings"
+
+	"github.com/byteness/keyring"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type countingReader struct {
+	reader io.Reader
+	reads  int
+}
+
+func (r *countingReader) Read(p []byte) (int, error) {
+	r.reads++
+
+	return r.reader.Read(p)
+}
+
+func envWith(values map[string]string) func(string) string {
+	return func(key string) string { return values[key] }
+}
+
+var _ = Describe("Keychain passphrase source", func() {
+	DescribeTable("resolves flag > environment > stdin",
+		func(flag, env, stdin string, useStdin bool, expected string) {
+			source := &keychainPassphraseSource{
+				flag:     flag,
+				getenv:   envWith(map[string]string{KeychainPassphraseEnv: env}),
+				stdin:    strings.NewReader(stdin),
+				useStdin: useStdin,
+			}
+
+			Expect(source.resolve()).To(Equal(expected))
+		},
+		Entry("flag wins over everything", "from-flag", "from-env", "from-stdin\n", true, "from-flag"),
+		Entry("environment wins over stdin", "", "from-env", "from-stdin\n", true, "from-env"),
+		Entry("stdin when requested", "", "", "from-stdin\n", true, "from-stdin"),
+		Entry("stdin without trailing newline", "", "", "from-stdin", true, "from-stdin"),
+		Entry("stdin with CRLF", "", "", "from-stdin\r\n", true, "from-stdin"),
+		Entry("stdin is ignored unless requested", "", "", "from-stdin\n", false, ""),
+		Entry("nothing set keeps the old behaviour", "", "", "", false, ""),
+	)
+
+	It("does not touch stdin when the environment supplies the passphrase", func() {
+		reader := &countingReader{reader: strings.NewReader("from-stdin\n")}
+		source := &keychainPassphraseSource{
+			getenv:   envWith(map[string]string{KeychainPassphraseEnv: "from-env"}),
+			stdin:    reader,
+			useStdin: true,
+		}
+
+		Expect(source.resolve()).To(Equal("from-env"))
+		Expect(reader.reads).To(BeZero())
+	})
+
+	It("reads stdin once and leaves the rest of the input unread", func() {
+		input := strings.NewReader("secret\nuser@example.test\n")
+		source := &keychainPassphraseSource{getenv: envWith(nil), stdin: input, useStdin: true}
+
+		Expect(source.resolve()).To(Equal("secret"))
+		Expect(source.resolve()).To(Equal("secret"))
+
+		rest, err := io.ReadAll(input)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(string(rest)).To(Equal("user@example.test\n"))
+	})
+
+	It("fails clearly on empty stdin", func() {
+		source := &keychainPassphraseSource{getenv: envWith(nil), stdin: strings.NewReader("\n"), useStdin: true}
+
+		_, err := source.resolve()
+		Expect(err).To(MatchError(ContainSubstring("stdin did not contain a passphrase")))
+	})
+
+	It("keeps the non-interactive error and names the new sources", func() {
+		callback := keychainFilePasswordFunc(&keychainPassphraseSource{getenv: envWith(nil)}, false)
+
+		_, err := callback("Enter passphrase to unlock /tmp/state")
+		Expect(err).To(MatchError(ContainSubstring("keychain passphrase is required when not running in interactive mode")))
+		Expect(err).To(MatchError(ContainSubstring(KeychainPassphraseEnv)))
+		Expect(err).To(MatchError(ContainSubstring("--keychain-passphrase-stdin")))
+	})
+
+	Describe("file keyring round trip", func() {
+		var dir string
+
+		BeforeEach(func() {
+			dir = GinkgoT().TempDir()
+			ring, err := keyring.Open(keyring.Config{
+				AllowedBackends:  []keyring.BackendType{keyring.FileBackend},
+				ServiceName:      "ipatool-passphrase-test",
+				FileDir:          dir,
+				FilePasswordFunc: keyring.FixedStringPrompt("correct horse"),
+			})
+			Expect(err).NotTo(HaveOccurred())
+			Expect(ring.Set(keyring.Item{Key: "account", Data: []byte("payload")})).To(Succeed())
+		})
+
+		open := func(source *keychainPassphraseSource) ([]byte, error) {
+			ring, err := keyring.Open(keyring.Config{
+				AllowedBackends:  []keyring.BackendType{keyring.FileBackend},
+				ServiceName:      "ipatool-passphrase-test",
+				FileDir:          dir,
+				FilePasswordFunc: keychainFilePasswordFunc(source, false),
+			})
+			Expect(err).NotTo(HaveOccurred())
+
+			item, err := ring.Get("account")
+
+			return item.Data, err
+		}
+
+		It("unlocks with the passphrase from the environment", func() {
+			data, err := open(&keychainPassphraseSource{getenv: envWith(map[string]string{KeychainPassphraseEnv: "correct horse"})})
+			Expect(err).NotTo(HaveOccurred())
+			Expect(string(data)).To(Equal("payload"))
+		})
+
+		It("unlocks with the passphrase from stdin", func() {
+			data, err := open(&keychainPassphraseSource{getenv: envWith(nil), stdin: strings.NewReader("correct horse\n"), useStdin: true})
+			Expect(err).NotTo(HaveOccurred())
+			Expect(string(data)).To(Equal("payload"))
+		})
+
+		It("rejects a wrong environment passphrase", func() {
+			_, err := open(&keychainPassphraseSource{getenv: envWith(map[string]string{KeychainPassphraseEnv: "wrong"})})
+			Expect(err).To(HaveOccurred())
+		})
+
+		It("prefers the flag over a wrong environment value", func() {
+			data, err := open(&keychainPassphraseSource{flag: "correct horse", getenv: envWith(map[string]string{KeychainPassphraseEnv: "wrong"})})
+			Expect(err).NotTo(HaveOccurred())
+			Expect(string(data)).To(Equal("payload"))
+		})
+	})
+})

+func validateCatalogIndependentDownloadResponse(res http.Result[downloadResult], app App) error {
+	if res.Data.FailureType != "" || res.Data.CustomerMessage != "" || len(res.Data.Items) == 0 {
+		return nil // Keep Apple's refusal for the normal account/license handler.
+	}
+	if res.StatusCode != gohttp.StatusOK || len(res.Data.Items) != 1 {
+		return errors.New("catalog-independent redownload must contain exactly one item")
+	}
+	metadata := res.Data.Items[0].Metadata
+	bundleID, ok := metadata["softwareVersionBundleId"].(string)
+	if fmt.Sprint(metadata["itemId"]) != fmt.Sprint(app.ID) || !ok || bundleID == "" ||
+		(app.BundleID != "" && bundleID != app.BundleID) {
+		return errors.New("catalog-independent redownload does not match the requested app")
+	}
+	return nil
+}

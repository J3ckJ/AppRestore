diff --git a/pkg/appstore/appstore_product_redirect.go b/pkg/appstore/appstore_product_redirect.go
new file mode 100644
index 0000000..3c31ef8
--- /dev/null
+++ b/pkg/appstore/appstore_product_redirect.go
@@ -0,0 +1,62 @@
+package appstore
+
+import (
+	"context"
+	"errors"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+)
+
+var storeProductHost = regexp.MustCompile(`^(p[0-9]{1,5}-)?buy\.itunes\.apple\.com$`)
+var errStoreProductRedirect = errors.New("invalid Apple product redirect")
+var errStoreProductRedirectLimit = errors.New("Apple product redirect limit")
+
+// Product POSTs must survive Store pod redirects. net/http otherwise changes
+// 301/302/303 POSTs to GETs. Replay only the same operation, body and account,
+// never a new purchase endpoint, storefront, GUID or arbitrary destination.
+func sendStoreProduct[R any](client http.Client[R], req http.Request) (http.Result[R], error) {
+	ctx := req.Context
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(ctx, 60*time.Second)
+	defer cancel()
+	req.Context, req.NoRedirects = ctx, true
+	for attempt := 0; attempt <= 3; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return http.Result[R]{}, err
+		}
+		res, err := client.Send(req)
+		if err != nil || !http.IsAuthenticationRedirect(res.StatusCode) {
+			return res, err
+		}
+		if attempt == 3 {
+			return res, errStoreProductRedirectLimit
+		}
+		location, locErr := res.GetHeader("Location")
+		base, baseErr := url.Parse(req.URL)
+		next, nextErr := url.Parse(location)
+		if locErr != nil || strings.TrimSpace(location) == "" || baseErr != nil || nextErr != nil {
+			return res, errStoreProductRedirect
+		}
+		next = base.ResolveReference(next)
+		host := strings.ToLower(next.Host)
+		if next.Scheme != "https" || !(storeProductHost.MatchString(host) || host == downloadDispatchDomain) ||
+			next.User != nil || next.Fragment != "" || next.Path != base.Path || next.RawPath != "" {
+			return res, errStoreProductRedirect
+		}
+		query, queryErr := url.ParseQuery(next.RawQuery)
+		baseQuery, baseQueryErr := url.ParseQuery(base.RawQuery)
+		if queryErr != nil || baseQueryErr != nil || (len(query) != 0 && query.Encode() != baseQuery.Encode()) {
+			return res, errStoreProductRedirect
+		}
+		// A relative/absolute Location may omit the original guid query.
+		next.RawQuery = base.RawQuery
+		req.URL = next.String()
+	}
+	return http.Result[R]{}, errStoreProductRedirectLimit
+}

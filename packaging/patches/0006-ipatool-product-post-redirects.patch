@@ -0,0 +1,100 @@
+package appstore
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"strconv"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+	"go.uber.org/mock/gomock"
+)
+
+func TestProductionDownloadPreservesProductPostOnRedirect(t *testing.T) {
+	for _, status := range []int{301, 302, 307, 308} {
+		t.Run(strconv.Itoa(status), func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			client := http.NewMockClient[downloadResult](ctrl)
+			store := &appstore{downloadClient: client}
+			acc := Account{DirectoryServicesID: "account", StoreFront: "143469-16"}
+			var original http.Request
+			gomock.InOrder(
+				client.EXPECT().Send(gomock.Any()).DoAndReturn(func(req http.Request) (http.Result[downloadResult], error) {
+					original = req
+					if !req.NoRedirects || req.Context == nil {
+						t.Fatal("production request still permits implicit HTTP redirects")
+					}
+					return http.Result[downloadResult]{StatusCode: status, Headers: map[string]string{
+						"Location": "https://p42-buy.itunes.apple.com" + PrivateAppStoreAPIPathDownload,
+					}}, nil
+				}),
+				client.EXPECT().Send(gomock.Any()).DoAndReturn(func(req http.Request) (http.Result[downloadResult], error) {
+					if req.Method != http.MethodPOST || !req.NoRedirects ||
+						req.URL != "https://p42-buy.itunes.apple.com"+PrivateAppStoreAPIPathDownload+"?guid=001122334455" ||
+						!reflect.DeepEqual(req.Payload, original.Payload) || !reflect.DeepEqual(req.Headers, original.Headers) {
+						t.Fatal("redirect changed the operation, body, GUID or account")
+					}
+					return http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{FailureType: FailureTypeLicenseNotFound}}, nil
+				}),
+			)
+			res, _, err := store.sendDownloadProduct(context.Background(), acc, App{ID: 1117817509}, "001122334455", "123", PlatformIPhone)
+			if err != nil || res.Data.FailureType != FailureTypeLicenseNotFound {
+				t.Fatal("lost the actual license refusal after redirect")
+			}
+		})
+	}
+}
+
+func TestProductionPurchaseRedirectPreservesPriceAndStorefront(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	client := http.NewMockClient[purchaseResult](ctrl)
+	store := &appstore{purchaseClient: client}
+	acc := Account{DirectoryServicesID: "account", PasswordToken: "token", StoreFront: "143469-16"}
+	client.EXPECT().Send(gomock.Any()).Return(http.Result[purchaseResult]{StatusCode: 302, Headers: map[string]string{
+		"Location": "https://p42-buy.itunes.apple.com" + PrivateAppStoreAPIPathPurchase,
+	}}, nil)
+	client.EXPECT().Send(gomock.Any()).DoAndReturn(func(req http.Request) (http.Result[purchaseResult], error) {
+		payload := req.Payload.(*http.XMLPayload).Content
+		if req.Method != http.MethodPOST || !req.NoRedirects || payload["price"] != "0" ||
+			payload["salableAdamId"] != int64(42) || payload["pricingParameters"] != PricingParameterAppStore ||
+			req.Headers["X-Apple-Store-Front"] != acc.StoreFront || req.Headers["X-Token"] != acc.PasswordToken {
+			t.Fatal("purchase redirect changed the requested transaction")
+		}
+		return http.Result[purchaseResult]{StatusCode: 200, Data: purchaseResult{JingleDocType: "purchaseSuccess", Status: 0}}, nil
+	})
+	if err := store.purchaseWithParams(acc, App{ID: 42}, "001122334455", PricingParameterAppStore); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestStoreRedirectRejectsAmbiguousQueryAndDoesNotRetryTransport(t *testing.T) {
+	for _, query := range []string{"guid=abc&guid=other", "guid=%zz", "guid=abc;country=US", "country=RU"} {
+		ctrl := gomock.NewController(t)
+		client := http.NewMockClient[downloadResult](ctrl)
+		client.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{StatusCode: 302, Headers: map[string]string{
+			"Location": "https://p42-buy.itunes.apple.com/r/redownload?" + query,
+		}}, nil)
+		_, err := sendStoreProduct(client, http.Request{Method: http.MethodPOST, URL: "https://downloaddispatch.itunes.apple.com/r/redownload?guid=abc"})
+		if !errors.Is(err, errStoreProductRedirect) {
+			t.Fatal("accepted an ambiguous or altered query")
+		}
+	}
+	ctrl := gomock.NewController(t)
+	client := http.NewMockClient[purchaseResult](ctrl)
+	want := errors.New("lost response")
+	client.EXPECT().Send(gomock.Any()).Return(http.Result[purchaseResult]{}, want).Times(1)
+	_, err := sendStoreProduct(client, http.Request{Method: http.MethodPOST, URL: "https://buy.itunes.apple.com" + PrivateAppStoreAPIPathPurchase})
+	if !errors.Is(err, want) {
+		t.Fatal("transport failure was changed or retried")
+	}
+}
+
+func TestStoreProductHonorsCancellationBeforeAnyRequest(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := sendStoreProduct[purchaseResult](nil, http.Request{Context: ctx})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal("ignored cancellation")
+	}
+}

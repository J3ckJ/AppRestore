@@ -163,23 +164,50 @@ func isEmptyRedownloadError(err error) bool {
 		unexpected.StatusCode == gohttp.StatusInternalServerError && unexpected.Snippet == ""
 }
 
-func (t *appstore) sendUpdateProduct(endpoint string, acc Account, app App, guid, externalVersionID string) (http.Result[downloadResult], error) {
+func (t *appstore) sendUpdateProduct(ctx context.Context, endpoint string, acc Account, app App, guid, externalVersionID string) (http.Result[downloadResult], error) {
 	update, err := newDownloadEndpoint(endpoint, updateProductPath)
 	if err != nil {
 		return http.Result[downloadResult]{}, err
 	}
 
-	// The bag's updateProduct can serve pinned iOS, macOS, and tvOS versions when redownload
-	// returns an empty HTTP 500 or a message-only availability error. Keep
-	// the same session and version selection.
-	res, err := sendStoreProduct(t.downloadClient, t.downloadProductRequest(update, acc, app, guid, externalVersionID))
+	// Apple can also select a licensed iOS build when no catalog version is
+	// available. Keep the same account and validate the selected identity;
+	// Download checks the package platform before applying Apple's SINF.
+	req := t.downloadProductRequest(update, acc, app, guid, externalVersionID)
+	if externalVersionID == "" {
+		req.Headers["X-Apple-Store-Front"] = acc.StoreFront
+		req.Headers["X-Token"] = acc.PasswordToken
+	}
+	res, err := t.sendStoreDownloadProduct(ctx, req)
 	if err != nil {
 		return res, fmt.Errorf("failed to send update request: %w", err)
 	}
 
+	if externalVersionID == "" {
+		return res, validateUnpinnedUpdateResponse(res, app)
+	}
 	return res, validateVersionedDownloadResponse(res, app, externalVersionID, "update")
 }
 
+func validateUnpinnedUpdateResponse(res http.Result[downloadResult], app App) error {
+	if err := validateCatalogIndependentDownloadResponse(res, app); err != nil {
+		return err
+	}
+	if res.Data.FailureType != "" || res.Data.CustomerMessage != "" || len(res.Data.Items) == 0 {
+		return nil // Preserve Apple's account/license/availability refusal.
+	}
+	item := res.Data.Items[0]
+	if !positiveProbeID(fmt.Sprint(item.Metadata["softwareVersionExternalIdentifier"])) || item.URL == "" {
+		return errors.New("catalog-independent update has no valid version or package URL")
+	}
+	for _, sinf := range item.Sinfs {
+		if len(sinf.Data) > 0 {
+			return nil
+		}
+	}
+	return errors.New("catalog-independent update has no license material")
+}
+
 func validateVersionedDownloadResponse(res http.Result[downloadResult], app App, externalVersionID, source string) error {
 	if res.Data.FailureType != "" {
 		return nil

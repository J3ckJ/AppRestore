diff --git a/pkg/appstore/appstore_unpinned_update_test.go b/pkg/appstore/appstore_unpinned_update_test.go
new file mode 100644
index 0000000..034d5d9
--- /dev/null
+++ b/pkg/appstore/appstore_unpinned_update_test.go
@@ -0,0 +1,170 @@
+package appstore
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+	"github.com/majd/ipatool/v2/pkg/util/machine"
+	"go.uber.org/mock/gomock"
+)
+
+func unpinnedUpdateFixture() http.Result[downloadResult] {
+	return http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{Items: []downloadItemResult{{
+		URL: "https://example.com/app.ipa", Sinfs: []Sinf{{Data: []byte("license")}},
+		Metadata: map[string]interface{}{"itemId": int64(42), "softwareVersionBundleId": "com.example.app", "softwareVersionExternalIdentifier": "123"},
+	}}}}
+}
+
+func TestUpdateWithoutCatalogOffer(t *testing.T) {
+	for _, kind := range []string{"empty_500", "unavailable", "empty_200", "license_refused", "authentication_refused"} {
+		t.Run(kind, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			download := http.NewMockClient[downloadResult](ctrl)
+			bag := http.NewMockClient[bagResult](ctrl)
+			catalog := http.NewMockClient[platformVersionLookupResult](ctrl)
+			store := &appstore{downloadClient: download, bagClient: bag, platformClient: catalog}
+			acc := Account{StoreFront: "143469-16,29", DirectoryServicesID: "account", PasswordToken: "private"}
+			app := App{ID: 42, BundleID: "com.example.app"}
+			res := http.Result[downloadResult]{StatusCode: 200}
+			var redownloadErr error
+			switch kind {
+			case "empty_500":
+				redownloadErr = &http.UnexpectedResponseError{StatusCode: 500}
+			case "unavailable":
+				res.Data.FailureType = FailureTypeTemporarilyUnavailable
+			case "license_refused":
+				res.Data.FailureType = FailureTypeLicenseNotFound
+			case "authentication_refused":
+				res.Data.FailureType = FailureTypeSignInRequired
+			}
+			expected := unpinnedUpdateFixture()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			gomock.InOrder(
+				download.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{StatusCode: 200}, nil),
+				bag.EXPECT().Send(gomock.Any()).Return(http.Result[bagResult]{StatusCode: 200, Data: bagResult{URLBag: urlBag{RedownloadEndpoint: testRedownloadEndpoint, UpdateEndpoint: testUpdateEndpoint}}}, nil),
+				catalog.EXPECT().Send(gomock.Any()).Return(http.Result[platformVersionLookupResult]{StatusCode: 200}, nil).Times(3),
+				download.EXPECT().Send(gomock.Any()).Return(res, redownloadErr),
+			)
+			if !strings.HasSuffix(kind, "refused") {
+				download.EXPECT().Send(gomock.Any()).DoAndReturn(func(req http.Request) (http.Result[downloadResult], error) {
+					if req.URL != testUpdateEndpoint+"?guid="+"001122334455" || req.Method != http.MethodPOST || !req.NoRedirects {
+						t.Fatal("wrong update operation")
+					}
+					p := req.Payload.(*http.XMLPayload).Content
+					for _, key := range []string{"appExtVrsId", "externalVersionId", "price", "pricingParameters"} {
+						if _, ok := p[key]; ok {
+							t.Fatal("unexpected version or purchase parameter")
+						}
+					}
+					if req.Headers["X-Apple-Store-Front"] != acc.StoreFront || req.Headers["X-Token"] != acc.PasswordToken || p["salableAdamId"] != app.ID {
+						t.Fatal("changed account, storefront or app")
+					}
+					cancel()
+					if req.Context.Err() != context.Canceled {
+						t.Fatal("lost cancellation context")
+					}
+					return expected, nil
+				})
+			}
+			actual, platform, err := store.sendDownloadProduct(ctx, acc, app, "001122334455", "", PlatformIPhone)
+			if err != nil || platform != PlatformIPhone {
+				t.Fatalf("unexpected result: %v %v", platform, err)
+			}
+			if strings.HasSuffix(kind, "refused") {
+				if actual.Data.FailureType != res.Data.FailureType {
+					t.Fatal("lost Apple refusal")
+				}
+			} else if len(actual.Data.Items) != 1 || actual.Data.Items[0].URL != expected.Data.Items[0].URL {
+				t.Fatal("did not recover the selected package")
+			}
+		})
+	}
+}
+
+func TestUnpinnedUpdateRequiresMatchingLicensedVersion(t *testing.T) {
+	app := App{ID: 42, BundleID: "com.example.app"}
+	if err := validateUnpinnedUpdateResponse(unpinnedUpdateFixture(), app); err != nil {
+		t.Fatal(err)
+	}
+	for name, mutate := range map[string]func(*http.Result[downloadResult]){
+		"wrong_app": func(r *http.Result[downloadResult]) { r.Data.Items[0].Metadata["itemId"] = 43 },
+		"wrong_bundle": func(r *http.Result[downloadResult]) {
+			r.Data.Items[0].Metadata["softwareVersionBundleId"] = "another.app"
+		},
+		"missing_version": func(r *http.Result[downloadResult]) {
+			delete(r.Data.Items[0].Metadata, "softwareVersionExternalIdentifier")
+		},
+		"zero_version": func(r *http.Result[downloadResult]) {
+			r.Data.Items[0].Metadata["softwareVersionExternalIdentifier"] = "0"
+		},
+		"no_package":     func(r *http.Result[downloadResult]) { r.Data.Items[0].URL = "" },
+		"empty_license":  func(r *http.Result[downloadResult]) { r.Data.Items[0].Sinfs = []Sinf{{}} },
+		"multiple_items": func(r *http.Result[downloadResult]) { r.Data.Items = append(r.Data.Items, r.Data.Items[0]) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			r := unpinnedUpdateFixture()
+			mutate(&r)
+			if validateUnpinnedUpdateResponse(r, app) == nil {
+				t.Fatal("accepted invalid offer")
+			}
+		})
+	}
+	for _, failure := range []string{FailureTypeLicenseNotFound, FailureTypeSignInRequired, FailureTypeTemporarilyUnavailable} {
+		if err := validateUnpinnedUpdateResponse(http.Result[downloadResult]{StatusCode: 200, Data: downloadResult{FailureType: failure}}, app); err != nil {
+			t.Fatal("lost refusal handling")
+		}
+	}
+}
+
+func TestProbeDiscoversVersionThroughUpdateWithoutCatalog(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	download := http.NewMockClient[downloadResult](ctrl)
+	bag := http.NewMockClient[bagResult](ctrl)
+	mach := machine.NewMockMachine(ctrl)
+	store := &appstore{downloadClient: download, bagClient: bag, machine: mach}
+	acc := Account{StoreFront: "143469-16,29", DirectoryServicesID: "account", PasswordToken: "private"}
+	mach.EXPECT().MacAddress().Return("00:11:22:33:44:55", nil)
+	bag.EXPECT().Send(gomock.Any()).Return(http.Result[bagResult]{StatusCode: 200, Data: bagResult{URLBag: urlBag{RedownloadEndpoint: testRedownloadEndpoint, UpdateEndpoint: testUpdateEndpoint}}}, nil)
+	download.EXPECT().Send(gomock.Any()).DoAndReturn(func(req http.Request) (http.Result[downloadResult], error) {
+		payload := req.Payload.(*http.XMLPayload).Content
+		if strings.HasPrefix(req.URL, testUpdateEndpoint) {
+			if payload["appExtVrsId"] == nil && (req.Headers["X-Token"] != acc.PasswordToken || req.Headers["X-Apple-Store-Front"] != acc.StoreFront) {
+				t.Fatal("missing account headers")
+			}
+			return unpinnedUpdateFixture(), nil
+		}
+		if version, ok := payload["appExtVrsId"]; ok && version != "123" {
+			t.Fatal("did not pin discovered version")
+		}
+		return http.Result[downloadResult]{StatusCode: 200}, nil
+	}).Times(8)
+	out, err := store.ProbeDownload(DownloadProbeInput{Account: acc, App: App{ID: 42, BundleID: "com.example.app"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, c := range out.Channels {
+		if c.Channel == "version_lookup" {
+			t.Fatal("unnecessarily queried missing public catalog")
+		}
+		if c.Channel == "update_unpinned" && c.VersionID == "123" && c.Status == "package_and_license_offered" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("did not discover a licensed version")
+	}
+}
+
+func TestUnpinnedUpdateHonorsCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := (&appstore{}).sendUpdateProduct(ctx, testUpdateEndpoint, Account{}, App{ID: 42}, "001122334455", "")
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal("update ignored cancellation")
+	}
+}
